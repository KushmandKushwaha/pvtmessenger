# Server-only environment variables. Never commit real values.
APP_NAME=Privacy Messenger
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3001
LOG_LEVEL=info

# PostgreSQL connection string
DATABASE_URL=postgresql://messenger_app:REPLACE_ME@localhost:5432/privacy_messenger
WS_PORT=3001
# Shared HMAC secret used only to issue/verify short-lived WebSocket tickets.
REALTIME_TICKET_SECRET=replace-with-a-long-random-secret
APP_ORIGIN=http://localhost:3000
TRUST_PROXY=false

# Private S3-compatible object storage. Never expose these to the browser.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=privacy-messenger
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Web Push notifications. Keep the private key server-side only.
WEB_PUSH_SUBJECT=mailto:admin@example.com
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
